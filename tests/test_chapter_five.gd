extends "res://tests/test_chapter_four.gd"
# Reuse the established real-pointer helpers; this suite has its own entry point,
# routes, assertions and in-memory progress. No user save is opened.

func _solve(c: PuzzleController, id: int) -> void:
	match id:
		51: _drop(c, "guard", "candle_zone")
		52:
			_swipe(c, "curtain_2")
			_tap(c, "window_2")
		53: _drop(c, "tile_0", "gap")
		54:
			for i in range(3): _drop(c, "water", "fill_%d" % i)
			_hold(c, "test", 3.0)
			_tap(c, "jug_1")
		55:
			for i in range(3): _drop(c, "hat_%d" % i, "head_%d" % i)
			for i in range(2): _drop(c, "link_%d" % i, "relation_%d" % i)
		56:
			_swipe(c, "rug", Vector2(-120, 0))
			_swipe(c, "latch", Vector2(0, 110))
			_drag(c, "shelf_right", Vector2(1590, 650))
			_tap(c, "door")
		57: _drop(c, "glass_1", "glass_zone_4")
		58:
			_cross_bridge(c, [0, 1], "right_bank")
			_cross_bridge(c, [0], "left_bank")
			_cross_bridge(c, [2, 3], "right_bank")
			_cross_bridge(c, [1], "left_bank")
			_cross_bridge(c, [0, 1], "right_bank")
		59:
			_tap(c, "box_2")
			_drop(c, "label_0", "label_zone_2")
			_drop(c, "label_1", "label_zone_0")
			_drop(c, "label_2", "label_zone_1")
		60:
			for i in range(3): _drop(c, "coin_%d" % i, "left")
			for i in range(3, 6): _drop(c, "coin_%d" % i, "right")
			_tap(c, "weigh")
			for i in range(6): _drop(c, "coin_%d" % i, "tray")
			_drop(c, "coin_6", "left")
			_drop(c, "coin_7", "right")
			_tap(c, "weigh")
			_tap(c, "coin_6")
		61:
			_cross_river(c, 1, "right_bank")
			_cross_river(c, -1, "left_bank")
			_cross_river(c, 0, "right_bank")
			_cross_river(c, 1, "left_bank")
			_cross_river(c, 2, "right_bank")
			_cross_river(c, -1, "left_bank")
			_cross_river(c, 1, "right_bank")
		62:
			_hold(c, "door_2")
			_swipe(c, "hatch", Vector2(0, -110))
			_drop(c, "key", "keyhole")
			_swipe(c, "door_2")
			_tap(c, "passage")
		63:
			_tap(c, "start")
			_tap(c, "next")
			_tap(c, "glass7")
			_feedback(c)
			_tap(c, "next")
			_tap(c, "glass7")
			_feedback(c)
			_tap(c, "next")
		64:
			_drop(c, "brush", "wall")
			_drag(c, "brick_4", Vector2(960, 900))
			_swipe(c, "latch", Vector2(0, 110))
			_tap(c, "door")
		65:
			_tap(c, "coin")
			c.action_runner._process(3.0)
			_tap(c, "cup_a")
		66:
			for i in range(3): _drop(c, "link_%d" % i, "gap_%d" % i)
			_drag(c, "rope_1", Vector2(960, 1010))
		67:
			_drop(c, "body", "body_zone")
			_drop(c, "neck_narrow", "neck_zone")
			_drop(c, "handle", "handle_right")
			_tap(c, "lamp")
		68:
			_drag(c, "book_1", Vector2(960, 850))
			_swipe(c, "book_latch", Vector2(0, 110))
			_slide_shelf(c, Vector2(1500, 650))
			_tap(c, "door")
		69:
			_tap(c, "piece_0")
			_tap(c, "piece_2")
			_tap(c, "piece_2")
			for i in range(3): _drop(c, "piece_%d" % i, "gap_%d" % i)
		70:
			for i in [0, 1, 6, 7]: _inspect_card(c, i)

func _cross_bridge(c: PuzzleController, people: Array, bank: String) -> void:
	for i: int in people: _tap(c, "person_%d" % i)
	_tap(c, "cross")
	c.action_runner._process(1.0)
	check(c.state.variables["bank"] == (1 if bank == "right_bank" else 0), "Crossing follows the displayed direction")

func _cross_river(c: PuzzleController, cargo: int, bank: String) -> void:
	if cargo >= 0: _tap(c, "cargo_%d" % cargo)
	_tap(c, "boat")
	check(c.state.variables["bank"] == (1 if bank == "right_bank" else 0), "The boat crosses in its indicated direction")

func _trap(c: PuzzleController, id: int, second: bool) -> void:
	match id:
		51:
			if second: _swipe(c, "vane", Vector2(0, 110))
			else: _drop(c, "opaque", "lantern_zone")
		52:
			if second: _hold(c, "photo")
			else: _tap(c, "yellow_light")
		53:
			if second: _hold(c, "stencil")
			else: _drop(c, "tile_1", "gap")
		54:
			if second: _tap(c, "cap")
			else: _drop(c, "cloth", "floor")
		55:
			if second: _hold(c, "brothers")
			else: _drop(c, "hat_3", "empty_person")
		56:
			if second: _swipe(c, "old_map", Vector2(0, -110))
			else: _drag(c, "chest", Vector2(420, 900))
		57:
			if second: _drop(c, "spoon", "spoon_zone")
			else: _drop(c, "coaster", "coaster_zone")
		58:
			var traveller: String = "person_0" if second else "time_1"
			_tap(c, traveller)
			_tap(c, traveller)
		59:
			if second: _tap(c, "color_stamp")
			else: _drop(c, "unknown", "label_zone_0")
		60:
			if second: _drop(c, "souvenir", "decoration")
			else: _hold(c, "magnifier")
		61:
			var cargo: String = "cargo_0" if second else "cargo_1"
			_tap(c, cargo)
			_tap(c, cargo)
		62: _hold(c, "door_0" if second else "door_1")
		63: _tap(c, "glass7" if second else "glass11")
		64:
			if second: _drag(c, "brick_4", Vector2(960, 900))
			else: _tap(c, "brick_0")
		65:
			if second: _tap(c, "cup_b")
			else: _tap(c, "cup_c")
		66: _drag(c, "rope_0" if second else "rope_1", Vector2(800 if second else 960, 1010))
		67:
			if second: _drop(c, "neck_wide", "neck_zone")
			else: _tap(c, "lamp")
		68:
			if second: _slide_shelf(c, Vector2(1500, 650))
			else: _drag(c, "book_0", Vector2(800, 850))
		69:
			if second: _drop(c, "piece_2", "gap_0")
			else: _drop(c, "piece_0", "gap_0")
		70:
			if second: _swipe(c, "card_0", Vector2(0, 110))
			else: _tap(c, "card_4")
	_feedback(c)

func _run() -> void:
	var packaged := PuzzleLoader.new().validate_all()
	check(packaged["ok"], "New content validates with all packaged resources: %s" % str(packaged["errors"]))
	if not packaged["ok"]:
		_finish()
		return
	var c := _controller()
	await process_frame
	for id in range(51, 71):
		check(c.load_level_index(id - 1), "Load stage %d" % id)
		for second: bool in [false, true]: _trap(c, id, second)
		check(c.run_status == "PLAYING" and not c.state.variables["solved"], "Neither trap solves stage %d" % id)
		_solve(c, id)
		check(c.run_status == "COMPLETED", "Real pointer solution completes stage %d" % id)
		c._process(1.1)
		check(c.overlay.visible and c.overlay.continue_button.visible, "Stage %d presents the result" % id)
	_negative_routes(c)
	_redesign_transitions(c)
	_migration()
	c.free()
	await _progression()
	_finish()

func _negative_routes(c: PuzzleController) -> void:
	c.load_level_index(50)
	c.action_runner._process(10.1)
	check(c.run_status == "FAILED" and c.current_result.is_empty(), "Wind extinguishes the unprotected candle without success")
	c.retry_level()
	check(c.object_nodes["flame"].visible and c.run_status == "PLAYING", "Retry restores the burning candle")
	var stale := {"type": "custom:animation_finished", "source": "wind", "run_id": c.state.run_id}
	c.load_level_index(51)
	c._on_interaction_event(stale)
	check(c.run_status == "PLAYING", "Old animation cannot fail the replacement stage")
	_tap(c, "curtain_2")
	check(c.run_status == "PLAYING", "A covered window supplies no evidence")
	c.load_level_index(52)
	_drop(c, "tile_1", "gap")
	check(c.run_status == "PLAYING", "Same background color with mismatched edges is rejected")
	c.load_level_index(53)
	_tap(c, "jug_1")
	_hold(c, "test", 3.0)
	check(not c.state.variables["tested"], "Leak test requires all three filled jars")
	for i in range(3):
		_drop(c, "water", "fill_%d" % i)
		check(c.object_nodes["water_%d" % i].visible and not c.object_nodes["empty_%d" % i].visible, "Filling shows an explicit full label")
		check(c.object_nodes["jug_%d" % i].sprite.texture.resource_path.ends_with("glass_bowl_full.svg"), "Filled jars show an actual water level")
	_hold(c, "test", 2.9)
	check(not c.state.variables["tested"] and not c.object_nodes["leak"].visible, "Releasing before three seconds does not reveal a leak")
	_hold(c, "test", 3.0)
	check(c.state.variables["tested"] and c.object_nodes["leak"].visible, "Holding the test button for three seconds reveals the next action")
	check(c.run_status == "PLAYING", "The leak still needs to be identified after the hold")
	c.clock.elapsed_usec = c.clock.limit_usec
	c._process(0.0)
	c.retry_level()
	for i in range(3):
		check(not c.state.variables["filled_%d" % i] and c.object_nodes["empty_%d" % i].visible and not c.object_nodes["water_%d" % i].visible, "Retry restores empty jar labels and totals")
		check(c.object_nodes["jug_%d" % i].sprite.texture.resource_path.ends_with("glass_bowl_empty.svg"), "Retry restores the empty jar image")
	check(not c.state.variables["tested"] and not c.object_nodes["leak"].visible, "Retry resets the experiment evidence")
	c.load_level_index(55)
	_drag(c, "shelf_right", Vector2(1590, 650))
	check(not c.state.variables["opened"] and not c.state.variables["solved"] and c.object_nodes["shelf_right"].position == Vector2(1250, 650), "A locked shelf cannot reveal the passage")
	check(c.object_nodes["jammed"].visible and not c.object_nodes["latch"].visible, "The hidden floor latch is discoverable through feedback")
	_swipe(c, "rug", Vector2(-120, 0))
	check(c.object_nodes["latch"].visible and c.object_nodes["scrape"].visible and not c.state.variables["unlocked"], "Moving the rug reveals the clue but does not release the shelf")
	_swipe(c, "latch", Vector2(0, -110))
	check(not c.state.variables["unlocked"], "The latch must move in its indicated direction")
	_swipe(c, "latch", Vector2(0, 110))
	check(c.state.variables["unlocked"] and not c.object_nodes["jammed"].visible, "Pulling the floor latch releases the shelf")
	_drag(c, "shelf_right", Vector2(1090, 650))
	check(not c.state.variables["opened"] and c.object_nodes["shelf_right"].position == Vector2(1250, 650), "Moving left does not reveal the door")
	_drag(c, "shelf_right", Vector2(1400, 650))
	check(not c.state.variables["opened"], "A short pull cannot expose the passage")
	_drag(c, "shelf_right", Vector2(1590, 650))
	check(c.state.variables["opened"] and c.object_nodes["door"].visible and c.run_status == "PLAYING", "The revealed passage still requires entering")
	_drag(c, "shelf_right", Vector2(1250, 650))
	check(c.object_nodes["shelf_right"].position == Vector2(1590, 650), "The opened shelf cannot cover the passage again")
	c.clock.elapsed_usec = c.clock.limit_usec
	c._process(0.0)
	c.retry_level()
	check(not c.state.variables["opened"] and not c.state.variables["unlocked"] and not c.object_nodes["door"].visible and not c.object_nodes["latch"].visible and not c.object_nodes["scrape"].visible, "Retry resets the latch and concealed passage")
	check(c.object_nodes["rug"].position == Vector2(1250, 900) and c.object_nodes["rug"].scale == Vector2(1.8, 0.4), "Retry restores the covering rug")
	_solve(c, 56)
	check(c.run_status == "COMPLETED", "The complete discovery route solves after retry")
	c.load_level_index(56)
	_drop(c, "glass_0", "glass_zone_4")
	check(c.run_status == "FAILED", "The only pickup cannot be spent on a different glass")
	c.retry_level()
	check(c.state.variables["lifts"] == 0, "Retry restores the pickup budget")
	c.load_level_index(57)
	_tap(c, "person_0")
	_tap(c, "person_1")
	_tap(c, "person_2")
	check(c.state.variables["aboard"] == 2 and c.state.variables["selection"] == 3, "A third traveller cannot board")
	check(c.object_nodes["selected_0"].visible and c.object_nodes["selected_1"].visible and not c.object_nodes["selected_2"].visible and c.object_nodes["cost_2"].visible, "Two bridge slots and the trip cost show the selection")
	_tap(c, "person_0")
	check(c.state.variables["selection"] == 2 and c.state.variables["aboard"] == 1 and c.object_nodes["person_1"].position == Vector2(850, 650), "Retapping deselects and compacts the bridge group")
	_tap(c, "time_2")
	check(c.state.variables["selection"] == 6 and c.object_nodes["cost_7"].visible and not c.object_nodes["cost_2"].visible, "Time labels also select the matching traveller and update trip cost")
	_tap(c, "time_2")
	_tap(c, "time_0")
	check(c.object_nodes["lamp"].visible and c.object_nodes["lamp"].position == Vector2(960, 690), "The selected group visibly carries the lantern onto the bridge")
	_tap(c, "cross")
	check(c.state.variables["crossing"] and c.state.variables["bank"] == 0 and c.state.variables["minutes"] == 0, "Arrival is committed after travelling with the lantern")
	c.action_runner._process(0.3)
	var lantern_offset: float = c.object_nodes["lamp"].sprite.global_position.x - c.object_nodes["lamp"].global_position.x
	var traveller_offset: float = c.object_nodes["person_0"].sprite.global_position.x - c.object_nodes["person_0"].global_position.x
	check(lantern_offset > 0 and is_equal_approx(lantern_offset, traveller_offset), "Travellers and lantern advance together at the same screen speed")
	_tap(c, "person_2")
	check(c.state.variables["selection"] == 3, "The travelling group cannot change during crossing")
	c.set_pause_reason("bridge_test", true)
	c.action_runner._process(2.0)
	check(c.state.variables["crossing"] and is_equal_approx(c.object_nodes["lamp"].sprite.global_position.x - c.object_nodes["lamp"].global_position.x, lantern_offset), "Pausing freezes the lantern and its group")
	c.set_pause_reason("bridge_test", false)
	c.action_runner._process(0.7)
	check(c.state.variables["people"] == 3 and c.state.variables["minutes"] == 2, "Crossing cost is the slower traveller, not two separate trips")
	check(c.object_nodes["lamp"].position == Vector2(1400, 730) and is_zero_approx(c.object_nodes["direction"].rotation_degrees) and not c.object_nodes["cross"].visible, "The lamp changes bank and the empty crossing becomes inactive")
	_tap(c, "person_2")
	check(c.state.variables["selection"] == 0, "People on the bank without the lamp cannot join")
	_tap(c, "person_0")
	_tap(c, "cross")
	c.action_runner._process(0.3)
	check(c.state.variables["crossing"] and c.object_nodes["lamp"].sprite.position.x < 0 and c.object_nodes["person_0"].sprite.position.x < 0, "The lantern visibly returns with its carrier")
	c.action_runner._process(0.7)
	check(c.state.variables["minutes"] == 3 and c.object_nodes["lamp"].position == Vector2(520, 730), "One traveller brings back the lamp before the next group")
	c.clock.elapsed_usec = c.clock.limit_usec
	c._process(0.0)
	c.retry_level()
	check(c.state.variables["bank"] == 0 and c.state.variables["minutes"] == 0 and c.state.variables["selection"] == 0 and not c.state.variables["transition"] and not c.state.variables["crossing"] and c.object_nodes["lamp"].sprite.position == Vector2.ZERO, "Retry clears elapsed minutes, travelling lantern and selection")
	for i in range(4):
		check(c.object_nodes["person_%d" % i].position == Vector2(370, 500 + i * 145) and not c.object_nodes["selected_%d" % i].visible, "Retry restores each traveller and selection check")
	_cross_bridge(c, [3], "right_bank")
	_cross_bridge(c, [3], "left_bank")
	check(c.run_status == "FAILED" and c.state.variables["minutes"] == 20, "Exceeding seventeen minutes still fails")
	c.retry_level()
	_solve(c, 58)
	check(c.run_status == "COMPLETED" and c.state.variables["minutes"] == 17, "The direct tap route preserves the seventeen-minute solution")
	c.load_level_index(58)
	_tap(c, "box_0")
	check(c.run_status == "FAILED", "An uninformative draw spends the single sample")
	c.load_level_index(59)
	_tap(c, "coin_6")
	check(c.run_status == "PLAYING", "Packaged identity alone cannot select the light coin")
	_drop(c, "coin_0", "left")
	_tap(c, "weigh")
	check(c.state.variables["weighings"] == 1 and c.state.variables["candidates"] == 9, "An unequal-count weighing spends budget without eliminating candidates")
	c.load_level_index(59)
	_drop(c, "coin_6", "left")
	_drop(c, "coin_7", "right")
	_tap(c, "weigh")
	check(c.state.variables["candidates"] == 1, "A one-versus-one lighter result uniquely identifies that candidate")
	_tap(c, "coin_6")
	check(c.run_status == "COMPLETED", "A valid one-weighing deduction is accepted")
	c.load_level_index(60)
	_cross_river(c, 0, "right_bank")
	check(c.run_status == "FAILED" and c.current_result.is_empty(), "Unattended goat and cabbage fail immediately")
	c.retry_level()
	check(c.state.variables["mask"] == 0 and c.state.variables["cargo"] == -1, "Retry restores both banks and empty boat")
	c.load_level_index(61)
	_swipe(c, "door_2")
	check(c.run_status == "PLAYING", "Lion door requires its motionless clue")
	c.load_level_index(62)
	_tap(c, "start")
	_tap(c, "next")
	check(c.state.variables["minutes"] == 7 and c.state.variables["remaining11"] == 4, "Next event advances real sand amounts")
	check(c.run_status == "PLAYING", "Seven simulated minutes cannot count as fifteen")
	_tap(c, "glass7")
	_feedback(c)
	_tap(c, "next")
	check(c.state.variables["minutes"] == 11 and c.state.variables["remaining7"] == 3, "Second boundary leaves three minutes of sand above")
	_tap(c, "glass7")
	_feedback(c)
	check(c.state.variables["remaining7"] == 4, "A partially full flip measures the complementary four minutes")
	_tap(c, "next")
	check(c.run_status == "COMPLETED", "Fifteen measured minutes complete automatically")
	c.load_level_index(64)
	_tap(c, "cup_a")
	check(c.run_status == "PLAYING", "Coin cannot be chosen before shuffling")
	_tap(c, "coin")
	c.set_pause_reason("test", true)
	c.action_runner._process(3.0)
	check(not c.state.variables["ready"], "Shuffling pauses with gameplay")
	c.set_pause_reason("test", false)
	c.action_runner._process(2.0)
	check(not c.state.variables["ready"] and c.object_nodes["tracking"].visible, "Choice stays locked during the five exchanges")
	_tap(c, "cup_a")
	check(c.run_status == "PLAYING" and not c.state.variables["solved"], "Tapping a moving cup cannot bypass the shuffle")
	c.action_runner._process(1.0)
	check(c.object_nodes["cup_a"].position.x == 1360 and c.object_nodes["cup_b"].position.x == 960 and c.object_nodes["cup_c"].position.x == 560, "Five exchanges preserve cup identities and final positions")
	check(c.state.variables["ready"] and c.object_nodes["choose"].visible and not c.object_nodes["tracking"].visible, "The single choice opens only after the shuffle ends")
	for wrong: String in ["cup_b", "cup_c"]:
		_tap(c, wrong)
		check(c.run_status == "FAILED" and c.current_result.is_empty(), "An incorrect cup spends the only choice")
		c.retry_level()
		check(not c.state.variables["ready"] and not c.state.variables["started"] and c.object_nodes["coin"].visible and c.object_nodes["instructions"].visible, "Retry restores the coin and initial shuffle state")
		check(c.object_nodes["cup_a"].position == Vector2(560, 690) and c.object_nodes["cup_a"].sprite.position == Vector2.ZERO, "Retry restores cup and sprite positions")
		_tap(c, "coin")
		c.action_runner._process(3.0)
	_tap(c, "cup_a")
	check(c.run_status == "COMPLETED", "Tracking the carrier still solves after a failed attempt")
	c.load_level_index(68)
	_drop(c, "piece_0", "gap_0")
	check(not c.state.variables["placed_0"] and c.run_status == "PLAYING", "A rotated motif cannot repair its matching gap")
	c.load_level_index(69)
	for i in [0, 1, 2, 6]: _inspect_card(c, i)
	check(c.run_status == "FAILED" and c.state.variables["scans"] == 4, "Four inspections including an unnecessary card exhaust the budget")
	c.load_level_index(69)
	for i in [7, 6, 1, 0]: _inspect_card(c, i)
	check(c.run_status == "COMPLETED", "The four necessary cards work in reverse order too")

func _old_progress(version: int = 8, count: int = 50, pending: bool = false) -> Dictionary:
	var old := super._old_progress(version, count, pending)
	return old

func _migration() -> void:
	var store := PuzzleProgressStore.new()
	store.manifest = PuzzleLoader.new().load_manifest()["data"]
	store.persistent = false
	for config: Array in [[3, 2], [4, 5], [5, 10], [6, 20], [7, 30], [8, 50]]:
		for pending: bool in [false, true]:
			var old := _old_progress(config[0], config[1], pending)
			if config[1] == 2:
				old["unlocked_hints"] = []
				old["hint_points_spent"] = 0
			var migrated := store._migrate_main_progress(old)
			check(store.valid(migrated) and migrated.get("manifest_version") == 10, "Known catalog migrates to the expanded catalog")
			check(migrated.get("results") == old["results"] and migrated.get("unlocked_hints") == old["unlocked_hints"] and migrated.get("hint_points_spent") == old["hint_points_spent"], "Migration preserves earned and spent points and hints")
			store.data = migrated
			if pending: check(store.advance(), "Pending old result advances only on Continue")
			check(store.data.get("current_level_id") == config[1] + 1, "Old completion unlocks the first new stage")
	var broken := _old_progress()
	broken["results"]["50"]["stars"] = 8
	check(store._migrate_main_progress(broken).is_empty(), "Broken progress is not silently reset")
	broken = _old_progress()
	broken["manifest_version"] = 99
	check(store._migrate_main_progress(broken).is_empty(), "Unknown catalog remains on the recovery path")

func _progression() -> void:
	var c := _controller()
	await process_frame
	c.allow_development_loading = false
	check(c.progress_store.commit(c.progress_store._migrate_main_progress(_old_progress())), "Prepare completed fifty-stage catalog in memory")
	check(c.load_level_index(50), "Normal play resumes at fifty-one")
	for id in range(51, 71):
		check(c.state.level_id == id, "Normal progression reaches %d" % id)
		_solve(c, id)
		check(c.progress_store.data["pending_result_level_id"] == id, "Result is saved once at %d" % id)
		c._process(1.1)
		c.continue_to_next_level()
	check(c.progress_store.data["current_level_id"] == 71 and c.progress_store.data["results"].size() == 70, "Continue after seventy unlocks seventy-one")
	check(not c.load_level_index(50), "Completed appended stages cannot be replayed")
	c.free()

func _finish() -> void:
	for failure: String in failures: printerr(failure)
	print("CHAPTER FIVE: %d checks, %d failures" % [checks, failures.size()])
	quit(0 if failures.is_empty() else 1)

func _inspect_card(c: PuzzleController, index: int) -> void:
	_swipe(c, "card_%d" % index, Vector2(-100, 0))
	# Each half starts only after the preceding animation's completion event.
	c.action_runner._process(0.2)
	c.action_runner._process(0.2)

func _slide_shelf(c: PuzzleController, destination: Vector2) -> void:
	var manager := c.interaction_manager
	var grab := Vector2(0, 130)
	var start := manager.stage_to_viewport(c.object_nodes["shelf"].position + grab)
	check(manager.pointer_pressed(start, 0), "Pick the exposed lower shelf frame")
	check(manager._active_object == c.object_nodes["shelf"], "Books do not intercept the frame grip")
	manager.pointer_moved(start + Vector2(25, 0), 0)
	var end := manager.stage_to_viewport(destination + grab)
	manager.pointer_moved(end, 0)
	manager.pointer_released(end, 0)

func _redesign_transitions(c: PuzzleController) -> void:
	c.load_level_index(59)
	_drop(c, "coin_0", "left")
	_drag(c, "coin_0", Vector2(360, 940))
	check(c.state.variables["side_0"] == 0 and c.object_nodes["coin_0"].position == Vector2(360, 920), "The far end of the visible mat removes a coin from the scale")
	c.load_level_index(60)
	_tap(c, "cargo_1")
	_tap(c, "cargo_0")
	check(c.state.variables["cargo"] == 1, "A loaded boat cannot take a second cargo")
	_tap(c, "cargo_1")
	check(c.state.variables["cargo"] == -1 and not c.object_nodes["selected_1"].visible, "Retapping unloads without a hidden destination")
	c.load_level_index(61)
	_hold(c, "door_2")
	_swipe(c, "door_2")
	check(not c.state.variables["opened"], "The lion clue does not unlock the door")
	_swipe(c, "hatch", Vector2(0, -110))
	check(c.state.variables["hatch_open"] and c.object_nodes["key"].visible, "The service hatch exposes a real key")
	c.clock.elapsed_usec = c.clock.limit_usec
	c._process(0.0)
	c.retry_level()
	check(not c.state.variables["hatch_open"] and not c.object_nodes["key"].visible and c.object_nodes["hatch"].visible, "Retry restores the closed service hatch")
	c.load_level_index(63)
	_drag(c, "brick_4", Vector2(960, 900))
	check(not c.state.variables["removed"], "An uncleared brick cannot expose its release")
	_drop(c, "brush", "wall")
	_drag(c, "brick_4", Vector2(960, 900))
	check(c.state.variables["removed"] and not c.state.variables["opened"], "The brick reveals a release instead of completing the level")
	c.load_level_index(65)
	for i in range(2): _drop(c, "link_%d" % i, "gap_%d" % i)
	_drag(c, "rope_1", Vector2(960, 1010))
	check(c.run_status == "PLAYING" and not c.state.variables["joined_2"], "Two repaired gaps leave a broken connection")
	c.load_level_index(66)
	_drop(c, "body", "body_zone")
	_drop(c, "neck_wide", "neck_zone")
	_drop(c, "handle", "handle_right")
	_tap(c, "lamp")
	check(c.run_status == "PLAYING" and c.object_nodes["cast_shadow"].visible, "The lamp displays an incorrect assembled shadow without solving")
	_drop(c, "neck_narrow", "neck_zone")
	_tap(c, "lamp")
	check(c.run_status == "COMPLETED", "Replacing the wrong neck corrects the physical model")
	c.load_level_index(67)
	_drag(c, "book_1", Vector2(960, 850))
	_slide_shelf(c, Vector2(1500, 650))
	check(not c.state.variables["opened"], "Pulling the book does not release the floor mechanism")
	c.load_level_index(68)
	_tap(c, "piece_0")
	_drop(c, "piece_0", "gap_0")
	check(c.state.variables["placed_0"] and c.run_status == "PLAYING", "One restored motif does not complete three repairs")
	c.clock.elapsed_usec = c.clock.limit_usec
	c._process(0.0)
	c.retry_level()
	check(not c.state.variables["placed_0"] and c.state.variables["angle_0"] == 270, "Retry restores the original motif orientation")
	c.load_level_index(69)
	_swipe(c, "card_0", Vector2(100, 0))
	_swipe(c, "card_0", Vector2(-30, 0))
	check(c.state.variables["flipping"] == -1 and c.state.variables["scans"] == 0, "Wrong-direction and short gestures do not spend an inspection")
	_swipe(c, "card_0", Vector2(-100, 0))
	_swipe(c, "card_1", Vector2(-100, 0))
	check(c.state.variables["flipping"] == 0 and c.state.variables["scans"] == 0, "A turning card reserves the inspection until the reveal finishes")
	c.action_runner._process(0.2)
	check(c.object_nodes["back_0"].visible and not c.object_nodes["card_0"].visible and c.state.variables["scans"] == 0, "The reverse opens before the inspection is counted")
	c.action_runner._process(0.2)
	check(c.state.variables["scans"] == 1 and c.object_nodes["back_0"].position == Vector2(420, 500) and c.object_nodes["check_0"].visible, "A revealed card stays at home and records one scan")
	var revealed_point := c.interaction_manager.stage_to_viewport(c.object_nodes["back_0"].position)
	check(not c.interaction_manager.pointer_pressed(revealed_point, 0) and c.state.variables["scans"] == 1, "A revealed card cannot spend another inspection")
	_swipe(c, "card_1", Vector2(-100, 0))
	var stale := {"type": "custom:animation_finished", "source": "card_1", "payload": {"animation": "card_flip/close"}, "run_id": c.state.run_id}
	c.clock.elapsed_usec = c.clock.limit_usec
	c._process(0.0)
	c.retry_level()
	c.rule_evaluator.enqueue_event(stale)
	c.action_runner._process(0.4)
	check(c.state.variables["scans"] == 0 and c.state.variables["flipping"] == -1 and c.object_nodes["card_1"].visible and not c.object_nodes["back_1"].visible, "Retry cancels an unfinished turn and ignores its stale completion")
